      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6685B58C-3499-4703-8C90-1CFDCC18E3B7}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE staging_sales;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insert Categories"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{11973937-897E-43E5-9AF4-965CD360C760}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insert Categories"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6685B58C-3499-4703-8C90-1CFDCC18E3B7}"
          SQLTask:SqlStatementSource="INSERT INTO dim_category (Category, SubCategory)&#xA;SELECT DISTINCT s.Category, s.SubCategory&#xA;FROM staging_sales s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dim_category dc&#xA;    WHERE dc.Category = s.Category AND dc.SubCategory = s.SubCategory&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insert Fact Sales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F649CCC5-2F95-43D7-93C5-19859EC112C4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insert Fact Sales"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6685B58C-3499-4703-8C90-1CFDCC18E3B7}"
          SQLTask:SqlStatementSource="INSERT INTO fact_sales (OrderID, DateKey, CategoryKey, CustomerID, Segment, City, [State], Region, Sales, Quantity, Discount, Profit, IsHoliday)&#xA;SELECT&#xA;    s.OrderID,&#xA;    CONVERT(INT, FORMAT(TRY_CAST(s.OrderDate AS DATE), 'yyyyMMdd')),&#xA;    dc.CategoryKey,&#xA;    s.CustomerID,&#xA;    s.Segment,&#xA;    s.City,&#xA;    s.[State],&#xA;    s.Region,&#xA;    s.Sales,&#xA;    s.Quantity,&#xA;    s.Discount,&#xA;    s.Profit,&#xA;    ISNULL(t.IsHoliday, 0)&#xA;FROM staging_sales s&#xA;INNER JOIN dim_category dc ON s.Category = dc.Category AND s.SubCategory = dc.SubCategory&#xA;LEFT JOIN dim_time t ON CONVERT(INT, FORMAT(TRY_CAST(s.OrderDate AS DATE), 'yyyyMMdd')) = t.DateKey&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM fact_sales f&#xA;    WHERE f.OrderID = s.OrderID&#xA;      AND f.DateKey = CONVERT(INT, FORMAT(TRY_CAST(s.OrderDate AS DATE), 'yyyyMMdd'))&#xA;      AND f.Sales = s.Sales&#xA;      AND f.CustomerID = s.CustomerID&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update Holiday Flags"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DA0AD05C-3B0C-430B-8FF2-51F474411ED3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Holiday Flags"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6685B58C-3499-4703-8C90-1CFDCC18E3B7}"
          SQLTask:SqlStatementSource="UPDATE t&#xA;SET t.IsHoliday = 1&#xA;FROM dim_time t&#xA;INNER JOIN dim_holiday h ON t.FullDate = h.HolidayDate&#xA;WHERE t.IsHoliday = 0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
