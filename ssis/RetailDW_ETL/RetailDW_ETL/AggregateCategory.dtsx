        <SQLTask:SqlTaskData
          SQLTask:Connection="{886CFE76-7B9C-4EBE-8CB1-18CC9C4D1384}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE agg_category_sales;&#xA; &#xA;INSERT INTO agg_category_sales (Category, SubCategory, TotalSales, TotalProfit, AvgDiscount, TotalQuantity)&#xA;SELECT&#xA;    c.Category,&#xA;    c.SubCategory,&#xA;    SUM(f.Sales),&#xA;    SUM(f.Profit),&#xA;    AVG(f.Discount),&#xA;    SUM(f.Quantity)&#xA;FROM fact_sales f&#xA;INNER JOIN dim_category c ON f.CategoryKey = c.CategoryKey&#xA;GROUP BY c.Category, c.SubCategory;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
